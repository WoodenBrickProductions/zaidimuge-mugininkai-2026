<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:padding="10dp"
    tools:context=".ReviewFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_small"
            android:background="@drawable/bg_banner">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageViewProfile"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginStart="4dp"
                android:contentDescription="profile image"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/textViewUsername"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:layout_marginStart="20dp"
                android:gravity="center_vertical"
                android:text="Vardenis Pavardenis"
                android:textSize="@dimen/text_20"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/imageViewProfile"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewUserRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="4dp"
                android:text="Reitingas"
                android:textSize="@dimen/text_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageViewProfile" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/val_8"
                    android:background="@color/secondary_background"
                    android:orientation="vertical"
                    android:padding="@dimen/val_8">

                    <TextView
                        android:id="@+id/textSeller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/seller"
                        android:textSize="@dimen/text_20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageViewProfile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center|left"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imageViewSellerProfile"
                            android:layout_width="@dimen/val_64"
                            android:layout_height="@dimen/val_64"
                            android:layout_marginStart="4dp"
                            android:contentDescription="profile image"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/CircleImageView"
                            tools:src="@tools:sample/avatars" />

                        <TextView
                            android:id="@+id/textSellerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/val_8"
                            android:layout_weight="1"
                            android:text="Reitingas"
                            android:textSize="@dimen/text_20"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/imageViewProfile" />

                    </LinearLayout>


                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/review_listing"
                    android:layout_width="wrap_content"
                    android:layout_height="165dp"
                    android:layout_gravity="center"
                    tools:listitem="@layout/listing_item_addable">

                </androidx.recyclerview.widget.RecyclerView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/val_8"
                    android:background="@color/secondary_background"
                    android:orientation="vertical"
                    android:padding="@dimen/val_8">

                    <TextView
                        android:id="@+id/textRating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/review_rating"
                        android:textSize="@dimen/text_20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageViewProfile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/buttonStar1"
                            style="@style/MyStarButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/val_64"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/buttonStar2"
                            style="@style/MyStarButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/val_64"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/buttonStar3"
                            style="@style/MyStarButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/val_64"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/buttonStar4"
                            style="@style/MyStarButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/val_64"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/buttonStar5"
                            style="@style/MyStarButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/val_64"
                            android:layout_weight="1" />

                    </LinearLayout>


                </LinearLayout>

                <EditText
                    android:id="@+id/reviewDescription"
                    style="@style/MyEditTextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/val_8"
                    android:ems="1000"
                    android:gravity="start|top"
                    android:hint="@string/review_the_product"
                    android:inputType="text|textMultiLine"
                    android:minHeight="@dimen/val_128"
                    android:singleLine="false" />

                <Button
                    android:id="@+id/buttonSubmit"
                    style="@style/MyButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/submit" />
            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</FrameLayout>