<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".SearchResultsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/spacing_medium"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <SearchView
            style="@style/MyEditTextField"
            android:id="@+id/searchViewResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

        </SearchView>

            <Button
                style="@style/MyButton"
                android:id="@+id/buttonFilters"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/filters"/>

        <LinearLayout
            android:id="@+id/filterView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/spacing_xlarge"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:textAlignment="center"
                android:text="@string/sorting_order" />

            <com.example.universityjava.CustomDropdown
                android:id="@+id/sortingFDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:textAlignment="center"
                android:text="@string/type" />

            <com.example.universityjava.CustomDropdown
                android:id="@+id/typeFDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:textAlignment="center"
                android:text="@string/platform" />

            <com.example.universityjava.CustomDropdown
                android:id="@+id/platformFDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/buttonFilter"
                style="@style/MyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/refresh" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSearchResults"
            android:layout_marginTop="@dimen/spacing_medium"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>
</FrameLayout>