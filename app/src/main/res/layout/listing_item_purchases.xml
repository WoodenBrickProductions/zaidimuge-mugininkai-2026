<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_holder"
    android:layout_width="365dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@color/secondary_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="12dp">

    <ImageView
        android:id="@+id/listing_image"
        android:layout_width="112dp"
        android:layout_height="140dp"
        tools:srcCompat="@tools:sample/avatars" />

    <Space
        android:layout_width="8dp"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/listing_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pavadinimas lorem ipsum lalalalal"
            android:textSize="@dimen/text_16" />

        <TextView
            android:id="@+id/listing_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eurai time"
            android:textSize="@dimen/text_24" />

        <Button
            android:id="@+id/buttonLeaveReview"
            style="@style/MyWhiteButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/val_48"
            android:layout_marginTop="0dp"
            android:text="@string/leave_review"
            android:visibility="visible" />

        <Button
            android:id="@+id/buttonEditReview"
            style="@style/MyButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/val_48"
            android:layout_marginTop="0dp"
            android:text="@string/view_review"
            android:visibility="gone" />

        <TextView
            android:id="@+id/order_state"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:text="Pavadinimas lorem ipsum"
            android:textSize="@dimen/text_16" />

    </LinearLayout>
</LinearLayout>