<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- disabled -->
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/main_background"/>
            <stroke android:color="@color/button_selected"
                android:width="2dp"/>
            <corners android:radius="@dimen/radius_small"/>
        </shape>
    </item>

    <!-- pressed -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/main_background"/>
            <stroke android:color="@color/button_selected"
                android:width="2dp"/>
            <corners android:radius="@dimen/radius_small"/>
        </shape>
    </item>

    <!-- default -->
    <item>
        <shape>
            <solid android:color="@color/secondary_background"/>
            <stroke android:color="@color/button_base"
                android:width="2dp"/>
            <corners android:radius="@dimen/radius_small"/>
        </shape>
    </item>

</selector>