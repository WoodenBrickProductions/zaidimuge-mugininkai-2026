<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MyBanner">
        <item name="android:layout_marginHorizontal">@dimen/val_8</item>
        <item name="android:layout_marginVertical">@dimen/val_8</item>
        <item name="android:paddingTop">@dimen/val_16</item>
        <item name="android:paddingBottom">@dimen/val_16</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/bg_banner</item>
    </style>

    <style name="MyButton" parent="Theme.AppCompat.DayNight">
        <item name="android:layout_marginTop">@dimen/val_16</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:padding">@dimen/val_8</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="MyWhiteButton">
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:padding">@dimen/val_8</item>
        <item name="android:background">@drawable/bg_white_button</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="MyEditTextField">
        <item name="android:layout_marginTop">@dimen/val_16</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:padding">@dimen/val_8</item>
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>