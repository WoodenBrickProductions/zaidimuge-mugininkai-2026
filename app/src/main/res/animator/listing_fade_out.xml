<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator android:propertyName="alpha"
        android:valueType="floatType"
        android:valueFrom="1"
        android:valueTo="0"
        android:duration="@integer/material_motion_duration_long_2"
        android:interpolator="@android:interpolator/accelerate_cubic"
        />
    <objectAnimator android:propertyName="scaleY"
        android:valueType="floatType"
        android:valueFrom="1"
        android:valueTo="0"
        android:duration="@integer/material_motion_duration_long_2"
        android:interpolator="@android:interpolator/accelerate_cubic"
        />
    <objectAnimator android:propertyName="visibility"
        android:valueType="intType"
        android:startOffset="@integer/material_motion_duration_long_2"
        android:valueFrom="0"
        android:valueTo="8"
        />
</set>